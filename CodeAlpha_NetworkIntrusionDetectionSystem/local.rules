# Custom Snort Rules

# Detect ICMP Ping
alert icmp any any -> $HOME_NET any (msg:"ICMP Ping Detected"; sid:1000001; rev:1;)

# Detect Port Scan
alert tcp any any -> $HOME_NET 1:1024 (msg:"Port Scan Detected"; flags:S; sid:1000002; rev:1;)

# Detect SSH Brute Force
alert tcp any any -> $HOME_NET 22 (msg:"SSH Brute Force Attempt"; flags:S; threshold:type both, track by_src, count 5, seconds 60; sid:1000003; rev:1;)
