# ICMP Ping Detection
alert icmp any any -> any any (msg:"ICMP Ping Detected"; sid:1000001; rev:1;)

# Port Scan Detection
alert tcp any any -> any 1:1024 (msg:"Port Scan Detected"; flags:S; sid:1000002; rev:1;)

# SSH Brute Force Detection
alert tcp any any -> any 22 (msg:"SSH Brute Force Attempt"; flags:S; threshold:type both, track by_src, count 5, seconds 60; sid:1000003; rev:1;)